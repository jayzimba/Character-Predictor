# Application
APP_NAME=Personality Classification Using Data Mining
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api

# Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend origin used for CORS in later phases
FRONTEND_URL=http://127.0.0.1:5173

# Database — used by Alembic and the seed script from Phase 2.
# Leave the password empty if your local MySQL root uses socket / no-password auth.
DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/personality_classification

# JWT — generate a long random value before Phase 4. Never commit a real secret.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Machine learning
ML_MODELS_DIR=app/ml/models
ML_DEMO_MODE=true
